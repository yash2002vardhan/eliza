{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "composite": true,
        "paths": {
            "@elizaos/core": ["../core/src"]
        }
    },
    "include": [
        "src/**/*",
        "../core/src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ],
    "references": [
        { "path": "../core" }
    ]
}

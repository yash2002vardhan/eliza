{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "target": "es2020",
        "module": "commonjs",
        "noEmit": false,
        "declaration": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "allowImportingTsExtensions": false,
        "lib": [
            "es2020",
            "dom"
        ],
        "moduleResolution": "node",
        "composite": true,
        "declarationMap": true,
        "paths": {
            "@elizaos/core": ["../../packages/core/dist"]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ],
    "references": [
        { "path": "../core" }
    ]
}
